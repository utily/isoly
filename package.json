{
	"name": "isoly",
	"version": "3.1.8",
	"description": "Datatypes and functions specified by ISO-standards.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/utily/isoly.git"
	},
	"bugs": {
		"url": "https://github.com/utily/isoly/issues"
	},
	"homepage": "https://github.com/utily",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"git": {
		"tagName": "release-${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"lint": "biome format .",
		"format": "biome format --write .",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@vitest/coverage-v8": "^4.1.5",
		"rimraf": "^6.1.3",
		"typescript": "6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"isly": "1.9.0"
	}
}
